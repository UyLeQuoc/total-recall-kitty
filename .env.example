# Kitty (total-recall-kitty). Copy to .env; never commit it.
# Memory: a Walrus Memory account on the mainnet relayer (memory.walrus.xyz).
# MEMWAL_ACCOUNT_ID is the MemWalAccount object id, not a wallet address.
MEMWAL_ACCOUNT_ID=             # your Walrus Memory account object ID (memory.walrus.xyz)
MEMWAL_PRIVATE_KEY=            # delegate private key, 64 hex. Server only.
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
TATUM_SUI_GRPC_TESTNET=https://sui-testnet-grpc.gateway.tatum.io
TATUM_API_KEY_TESTNET=
SPONSOR_PRIVATE_KEY_TESTNET=   # runtime gas sponsor, testnet (ADR-0026)
TELEGRAM_BOT_TOKEN=
SPIKE_OWNER_KEY=
DATABASE_URL=postgres://kitty:kitty@localhost:5436/kitty

# Kitty
KITTY_PORT=8821
KITTY_BASE_URL=http://localhost:8821
KITTY_WORKER=off
KITTY_BOT=off
KITTY_KEEPER_SECONDS=60
KITTY_PACKAGE_ID=
KITTY_KEEPER_KEY=
KITTY_MEMBER_KEYS=

# Kitty's agents (KT4, ADR-0067). Generated by apps/kitty/scripts/setup-testnet.ts. The agent's key lives
# on the agent's side only: its stdio MCP server (apps/kitty/src/mcp/stdio.ts) holds it, never the server.
KITTY_AGENT_KEY=
KITTY_API_URL=http://localhost:8821
# The reference treasurer agent (apps/kitty/agents/treasurer) decides with an OpenRouter model.
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-2.5-flash
